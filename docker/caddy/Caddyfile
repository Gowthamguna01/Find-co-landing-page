(static) {
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.json *.webp
    }
    header @static Cache-Control max-age=5184000
}

http://pixalto.app, https://www.pixalto.app {
    redir https://pixalto.app{uri} permanent
}

https://pixalto.app, https://manage.pixalto.app {
    @hasCloudflare {
        header X-Real-IP {>CF-Connecting-IP}
        header X-Forwarded-For {>CF-Connecting-IP}
        header X-Forwarded-Proto {>X-Forwarded-Proto}
        not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
    }

    reverse_proxy @hasCloudflare {
        to app:9000
    }

    # Add security headers to prevent clickjacking
    header {
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none';"
    }

    root * /var/www/html/public
    encode gzip
    php_fastcgi app:9000
    file_server
    import static
}

https://socket.pixalto.app {
    reverse_proxy soketi:6001
    # Add security headers to prevent clickjacking for the socket as well
    header {
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none';"
    }
}
